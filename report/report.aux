\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Dataset size by task. OmniCrack30k (30,017 images) dominates the corpus, providing a large-scale multi-source segmentation benchmark. DACL10k (7,910 images) is the primary detection source. StructDamage (14,702 images) is perfectly balanced across splits and anchors the classification task. Colour encodes task: blue = classification, red = detection, green = segmentation.}}{12}{figure.caption.4}\protected@file@percent }
\newlabel{fig:dataset_overview}{{2}{12}{Dataset size by task. OmniCrack30k (30,017 images) dominates the corpus, providing a large-scale multi-source segmentation benchmark. DACL10k (7,910 images) is the primary detection source. StructDamage (14,702 images) is perfectly balanced across splits and anchors the classification task. Colour encodes task: blue = classification, red = detection, green = segmentation}{figure.caption.4}{}}
\newlabel{eq:hist_crack_ratio}{{1}{12}{Exploratory Data Analysis}{equation.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Classification dataset balance. StructDamage (left) maintains a perfect 50/50 split across all three data splits. Historical Crack (right) is strongly skewed: intact images outnumber cracked images 4:1, requiring weighted sampling or loss re-weighting to avoid majority-class collapse during evaluation.}}{12}{figure.caption.5}\protected@file@percent }
\newlabel{fig:class_balance}{{3}{12}{Classification dataset balance. StructDamage (left) maintains a perfect 50/50 split across all three data splits. Historical Crack (right) is strongly skewed: intact images outnumber cracked images 4:1, requiring weighted sampling or loss re-weighting to avoid majority-class collapse during evaluation}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces DACL10k training set: class distribution (left), normalised bounding-box width/height scatter coloured by class (centre), and annotations-per-image histogram (right, mean 3.85 shown as dashed red line). The long tail from crack to wetspot and the concentration of small boxes (width/height $<$\,0.1) inform focal loss weighting and SAHI tiled inference.}}{13}{figure.caption.6}\protected@file@percent }
\newlabel{fig:dacl_class_dist}{{4}{13}{DACL10k training set: class distribution (left), normalised bounding-box width/height scatter coloured by class (centre), and annotations-per-image histogram (right, mean 3.85 shown as dashed red line). The long tail from crack to wetspot and the concentration of small boxes (width/height $<$\,0.1) inform focal loss weighting and SAHI tiled inference}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Six DACL10k training images annotated with ground-truth bounding boxes, selected to show multi-class co-occurrence. Colours indicate defect class: red = crack, blue = efflorescence, orange = spalling, purple = weathering, teal = wetspot. Most images contain two or more damage types, motivating joint multi-class detection over independent binary detectors.}}{13}{figure.caption.7}\protected@file@percent }
\newlabel{fig:detection_samples}{{5}{13}{Six DACL10k training images annotated with ground-truth bounding boxes, selected to show multi-class co-occurrence. Colours indicate defect class: red = crack, blue = efflorescence, orange = spalling, purple = weathering, teal = wetspot. Most images contain two or more damage types, motivating joint multi-class detection over independent binary detectors}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces DACL10k defect class co-occurrence. Left: raw image counts per class pair (diagonal = total images containing that class). Right: conditional probability $P(\text  {col class} \mid \text  {row class present})$, row-normalised. Crack co-occurs with nearly every other damage type; wetspot is the most isolated class.}}{14}{figure.caption.8}\protected@file@percent }
\newlabel{fig:cooccurrence}{{6}{14}{DACL10k defect class co-occurrence. Left: raw image counts per class pair (diagonal = total images containing that class). Right: conditional probability $P(\text {col class} \mid \text {row class present})$, row-normalised. Crack co-occurs with nearly every other damage type; wetspot is the most isolated class}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Per-class bounding-box width (left) and height (right) distributions. White horizontal line = median; thick white bar = IQR. Crack and efflorescence are narrow; spalling is the smallest class overall; weathering and wetspot span large, highly variable box sizes consistent with diffuse damage covering broad facade areas.}}{15}{figure.caption.9}\protected@file@percent }
\newlabel{fig:bbox_violin}{{7}{15}{Per-class bounding-box width (left) and height (right) distributions. White horizontal line = median; thick white bar = IQR. Crack and efflorescence are narrow; spalling is the smallest class overall; weathering and wetspot span large, highly variable box sizes consistent with diffuse damage covering broad facade areas}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Segmentation gallery: original image (left column), ground-truth binary mask (centre), and red-channel overlay (right). The $\rho $ values annotated on each mask confirm that crack pixels are a small minority even in visibly damaged images, making pixel accuracy an unreliable metric.}}{16}{figure.caption.10}\protected@file@percent }
\newlabel{fig:seg_gallery}{{8}{16}{Segmentation gallery: original image (left column), ground-truth binary mask (centre), and red-channel overlay (right). The $\rho $ values annotated on each mask confirm that crack pixels are a small minority even in visibly damaged images, making pixel accuracy an unreliable metric}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Crack morphology via connected-component labelling. Left: log-scale segment area distribution; dashed lines = class means. Centre: distinct crack segments per image (CrackForest has more, smaller segments; Masonry has fewer, larger ones). Right: box-plot comparison of log segment area.}}{17}{figure.caption.11}\protected@file@percent }
\newlabel{fig:crack_morphology}{{9}{17}{Crack morphology via connected-component labelling. Left: log-scale segment area distribution; dashed lines = class means. Centre: distinct crack segments per image (CrackForest has more, smaller segments; Masonry has fewer, larger ones). Right: box-plot comparison of log segment area}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Original image resolution (width vs.\ height) across all six datasets, with 120 images sampled per dataset. DACL10k spans the widest range of resolutions and includes large $1{,}000$--$3{,}000\,\text  {px}$ images, making downsampling to $640\,\text  {px}$ potentially lossy for hairline crack detail.}}{17}{figure.caption.12}\protected@file@percent }
\newlabel{fig:resolution}{{10}{17}{Original image resolution (width vs.\ height) across all six datasets, with 120 images sampled per dataset. DACL10k spans the widest range of resolutions and includes large $1{,}000$--$3{,}000\,\text {px}$ images, making downsampling to $640\,\text {px}$ potentially lossy for hairline crack detail}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Mean per-channel RGB intensity histograms (80 images sampled per dataset) for StructDamage, DACL10k, and CrackForest. Heritage datasets (DACL10k, CrackForest) are dominated by grey tones and lack the colour diversity of StructDamage, motivating colour jitter augmentation.}}{18}{figure.caption.13}\protected@file@percent }
\newlabel{fig:rgb_hist}{{11}{18}{Mean per-channel RGB intensity histograms (80 images sampled per dataset) for StructDamage, DACL10k, and CrackForest. Heritage datasets (DACL10k, CrackForest) are dominated by grey tones and lack the colour diversity of StructDamage, motivating colour jitter augmentation}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Domain shift quantified by brightness and contrast across all six datasets (120 images sampled each). White bar = IQR; horizontal dashed line = ImageNet neutral grey (128). CrackForest is the darkest dataset; Masonry has the lowest contrast — explaining its higher false-negative rate for thin crack segmentation.}}{18}{figure.caption.14}\protected@file@percent }
\newlabel{fig:brightness_contrast}{{12}{18}{Domain shift quantified by brightness and contrast across all six datasets (120 images sampled each). White bar = IQR; horizontal dashed line = ImageNet neutral grey (128). CrackForest is the darkest dataset; Masonry has the lowest contrast — explaining its higher false-negative rate for thin crack segmentation}{figure.caption.14}{}}
