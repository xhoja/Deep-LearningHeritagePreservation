\@writefile{lot}{\contentsline {table}{\numberline {18}{\ignorespaces Synthetic temporal degradation stages. Crack textures at Stages 2 and 3 are drawn from Masonry and CrackForest ground-truth masks, ensuring morphological realism.}}{33}{table.caption.25}\protected@file@percent }
\newlabel{tab:degradation_stages}{{18}{33}{Synthetic temporal degradation stages. Crack textures at Stages 2 and 3 are drawn from Masonry and CrackForest ground-truth masks, ensuring morphological realism}{table.caption.25}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Synthetic temporal degradation pipeline applied to one facade sample. Stage 0: original undegraded image. Stage 1: HSV colour shift (yellowing) and additive film grain. Stage 2: thin crack overlay from eroded ground-truth mask with biological growth patches. Stage 3: dilated thick cracks, heavy discolouration, and white efflorescence deposits. The crack morphology at Stages 2--3 is drawn from real Masonry and CrackForest ground-truth masks, ensuring realism. SSIM relative to Stage 0: 1.000, 0.844, 0.483, 0.321.}}{33}{figure.caption.26}\protected@file@percent }
\newlabel{fig:degradation}{{8}{33}{Synthetic temporal degradation pipeline applied to one facade sample. Stage 0: original undegraded image. Stage 1: HSV colour shift (yellowing) and additive film grain. Stage 2: thin crack overlay from eroded ground-truth mask with biological growth patches. Stage 3: dilated thick cracks, heavy discolouration, and white efflorescence deposits. The crack morphology at Stages 2--3 is drawn from real Masonry and CrackForest ground-truth masks, ensuring realism. SSIM relative to Stage 0: 1.000, 0.844, 0.483, 0.321}{figure.caption.26}{}}
