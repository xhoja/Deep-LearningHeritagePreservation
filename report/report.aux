\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Grad-CAM++ attention maps for EfficientNet-B4. Top row: original images (left three intact, right three cracked). Bottom row: heatmap overlays. On intact images the model attends to broad surface regions with low activation; on cracked images the heatmap concentrates tightly along the crack trajectory, confirming the model learned spatially localised crack-edge representations rather than global texture statistics.}}{26}{figure.caption.16}\protected@file@percent }
\newlabel{fig:gradcam}{{6}{26}{Grad-CAM++ attention maps for EfficientNet-B4. Top row: original images (left three intact, right three cracked). Bottom row: heatmap overlays. On intact images the model attends to broad surface regions with low activation; on cracked images the heatmap concentrates tightly along the crack trajectory, confirming the model learned spatially localised crack-edge representations rather than global texture statistics}{figure.caption.16}{}}
